plot_df <- df %>%
filter(
is.na(rejectWalkDist) | rejectWalkDist != 1,
!is.na(dropDist),
!is.na(TotSesh_actTest_RoundNum),
TotSesh_actTest_RoundNum < 51,
dropDist <= 1.1,
!is.na(coinLabel)
) %>%
mutate(
coinLabel = factor(coinLabel, levels = c("HV", "LV", "NV"))
)
